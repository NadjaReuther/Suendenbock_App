@model ArchivViewModel
@{
    ViewData["Title"] = "Archiv";
    ViewData["Bereich"] = "Archiv";
    var sl = Model.IstSpielleitung;
    var kiste = Model.Kiste;
    var doc = Model.Dokument;
    string? kisteCode = kiste?.Code;

    // Ein Dokument auf dem Pult: Papier je nach Art, Briefe und Notizen handschriftlich (JS: arPaperHtml)
    string PapierKlasse(ArchivDokument d)
    {
        var art = (d.Art ?? "Bericht").ToLowerInvariant();
        var k = "ar-paper k-" + art;
        if (d.Art == "Brief" || d.Art == "Notiz") k += " hand";
        return k;
    }
    var kistenCodes = doc?.Kategorien.Select(x => x.ArchivKategorieId).ToHashSet() ?? new HashSet<int>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/hesparis-archiv.css" asp-append-version="true" />
}

<div class="md-wrap" id="md-archiv">
    <div class="ar-full">
        <div class="ar-left">
            <div class="ar-head">
                <div class="armory-eyebrow">Verwaltung · Archiv · nur mit Erlaubnis</div>
                <h2 class="armory-title">Das Aktenregal</h2>
                <p class="ar-sub">Akten, Briefe und Berichte der Akademie, manche noch aus der Zeit vor dem Umbruch. Zieh eine Kiste heraus.</p>
                <form class="ar-inline" asp-action="Abschliessen" method="post"><button type="submit" class="icon-btn ar-lockbtn">⚿&#xFE0E; Tür hinter euch abschließen</button></form>
                @if (sl)
                {
                    <a class="icon-btn ar-lockbtn" asp-action="Index" asp-route-tuer="true">Tür und Schlüssel einstellen</a>
                }
            </div>

            @* ------------------------------------------------ Regale, je vier Kisten *@
            <div class="ar-shelves">
                @for (int s = 0; s < Math.Max(1, (Model.Kisten.Count + 3) / 4); s++)
                {
                    var reihe = Model.Kisten.Skip(s * 4).Take(4).ToList();
                    <div class="ar-shelf">
                        <span class="ar-slbl">REGAL @ArchivRegeln.Regal(s)</span>
                        @foreach (var b in reihe)
                        {
                            <a class="@(b.Code == kisteCode ? "ar-box on" : "ar-box")" style="--bc:@b.Farbe" asp-action="Index" asp-route-kiste="@b.Code" aria-label="Kiste @b.Signatur, @b.Name">
                                <span class="ar-label">@b.Signatur<small>@b.Name</small></span><span class="ar-count">@b.Anzahl @(b.Anzahl == 1 ? "Dokument" : "Dokumente")</span>
                            </a>
                        }
                        @if (reihe.Count == 0)
                        {
                            <p class="ar-empty">Noch keine Kisten.</p>
                        }
                    </div>
                }
            </div>

            @* ------------------------------------------------ Inhalt der Kiste *@
            @if (kiste != null)
            {
                <div class="ar-inbox">
                    <span class="ar-ilbl">In der Kiste @kiste.Signatur · @kiste.Name</span>
                    <div class="ar-docs">
                        @foreach (var x in Model.Dokumente)
                        {
                            var klasse = "ar-doc";
                            if (doc != null && x.Id == doc.Id) klasse += " on";
                            if (x.Verborgen) klasse += " hid";
                            <a class="@klasse" asp-action="Index" asp-route-kiste="@kisteCode" asp-route-dok="@x.Id">@ArchivRegeln.Symbol(x.Art)&#xFE0E; @(string.IsNullOrEmpty(x.Titel) ? "Ohne Titel" : x.Titel)@if (x.Verborgen) {<text> </text><em>versteckt</em>}@if (x.Versiegelt) {<text> </text><em>versiegelt</em>}</a>
                        }
                        @if (Model.Dokumente.Count == 0)
                        {
                            <p class="ar-empty">Die Kiste ist leer.</p>
                        }
                        @if (sl)
                        {
                            <form class="ar-inline" asp-action="DokumentNeu" method="post"><input type="hidden" name="kiste" value="@kisteCode" /><button type="submit" class="ar-doc add">+ Dokument</button></form>
                        }
                    </div>
                </div>
            }

            @* ------------------------------------------------ Spielleitung: Kategorien *@
            @if (sl)
            {
                <details class="ar-katsl" open="@Model.KategorienOffen">
                    <summary>Spielleitung · Kategorien (Kisten)</summary>
                    <form id="arKisteForm" asp-action="KisteFeld" method="post" hidden></form>
                    <div class="ar-katlist">
                        @foreach (var (k, n) in Model.Kategorien)
                        {
                            <div class="ar-katrow">
                                <input data-kiste="@k.Id" data-feld="signatur" maxlength="8" value="@k.Signatur" aria-label="Signatur" />
                                <input data-kiste="@k.Id" data-feld="name" maxlength="40" value="@k.Name" aria-label="Name der Kategorie" />
                                <span class="ar-kn">@n</span>
                                <form class="ar-inline" asp-action="KisteLoeschen" method="post"><input type="hidden" name="id" value="@k.Id" /><button type="submit" class="icon-btn" aria-label="Kategorie @k.Name entfernen" data-zweistufig data-frage="?">✕</button></form>
                            </div>
                        }
                        <form class="ar-katrow add" asp-action="KisteNeu" method="post" autocomplete="off">
                            <input name="signatur" maxlength="8" placeholder="F-01" aria-label="Signatur" />
                            <input name="name" maxlength="40" placeholder="Neue Kategorie" aria-label="Name" required />
                            <button type="submit" class="btn-primary">+ Kiste</button>
                        </form>
                        <p class="md-hint">Wird eine Kategorie entfernt, bleiben ihre Dokumente erhalten. Haben sie sonst keine Kategorie mehr, liegen sie in „Ohne Kategorie“.</p>
                    </div>
                </details>
            }
        </div>

        @* ================================================ das Lesepult *@
        <div class="ar-desk">
            @if (doc == null)
            {
                <p class="ar-empty big">Nichts auf dem Lesepult.</p>
            }
            else if (Model.Bearbeiten)
            {
                <form class="ar-form" asp-action="DokumentSpeichern" method="post">
                    <input type="hidden" name="id" value="@doc.Id" />
                    <input type="hidden" name="kiste" value="@kisteCode" />
                    <div class="rg-lbl">Spielleitung · Dokument bearbeiten</div>
                    <div class="ar-fgrid">
                        <label class="wide"><span>Titel</span><input name="titel" maxlength="80" value="@doc.Titel" autofocus /></label>
                        <label>
                            <span>Art</span>
                            <select name="art">
                                @foreach (var a in ArchivRegeln.Arten)
                                {
                                    <option selected="@(a == doc.Art)">@a</option>
                                }
                            </select>
                        </label>
                        <label><span>Signatur</span><input name="signatur" maxlength="20" value="@doc.Signatur" /></label>
                        <label class="wide"><span>Datum / Ort</span><input name="datum" maxlength="80" value="@doc.DatumText" placeholder="z. B. Hesparis, 14. März · Jahrgang 61" /></label>
                        <label class="wide"><span>Text</span><textarea name="text" rows="8" maxlength="4000">@doc.Text</textarea></label>
                        <label class="wide"><span>Unterschrift</span><input name="unterschrift" maxlength="60" value="@doc.Unterschrift" /></label>
                    </div>
                    <div class="ar-flbl">Kategorien <em>eine oder mehrere</em></div>
                    <div class="ar-katpick">
                        @foreach (var (k, _) in Model.Kategorien)
                        {
                            var an = kistenCodes.Contains(k.Id);
                            <label class="@(an ? "ar-kc on" : "ar-kc")"><input type="checkbox" name="kisten" value="@k.Code" checked="@an" hidden />@k.Name</label>
                        }
                    </div>
                    <div class="ar-fchecks">
                        <label><input type="checkbox" name="versiegelt" value="true" checked="@doc.Versiegelt" /> versiegelt</label>
                        <label><input type="checkbox" name="verborgen" value="true" checked="@doc.Verborgen" /> für die Spieler noch versteckt</label>
                    </div>
                    <div class="ar-fbtns">
                        <button type="submit" class="icon-btn" formaction="@Url.Action("DokumentLoeschen", new { id = doc.Id, kiste = kisteCode })" formnovalidate data-zweistufig data-frage="wirklich löschen?">Dokument löschen</button>
                        <button type="submit" class="btn-primary">Fertig</button>
                    </div>
                </form>
            }
            else
            {
                if (doc.Versiegelt && !sl)
                {
                    <div class="ar-sealed">
                        <span class="ar-ssig">@doc.Signatur</span><span class="ar-seal">H</span>
                        <span class="ar-stxt">VERSIEGELT<br>Nur für die Schulleitung</span>
                        <span class="ar-snote">@doc.Titel</span>
                    </div>
                }
                else
                {
                    <article class="@PapierKlasse(doc)">
                        <div class="ar-ptop"><span>@doc.Art</span><span>@doc.Signatur</span></div>
                        <h3>@(string.IsNullOrEmpty(doc.Titel) ? "Ohne Titel" : doc.Titel)</h3>
                        @if (!string.IsNullOrEmpty(doc.DatumText))
                        {
                            <span class="ar-pdate">@doc.DatumText</span>
                        }
                        <p class="@(doc.Art == "Telegramm" ? "ar-pbody tele" : "ar-pbody")">@Html.Raw(System.Net.WebUtility.HtmlEncode(doc.Text ?? "").Replace("\n", "<br>"))</p>
                        @if (!string.IsNullOrEmpty(doc.Unterschrift))
                        {
                            <span class="ar-psign">@doc.Unterschrift</span>
                        }
                        @if (Model.Kisten.Any(k => k.Code == ArchivRegeln.Umbruch && k.Id.HasValue && doc.Kategorien.Any(x => x.ArchivKategorieId == k.Id)))
                        {
                            <span class="ar-stamp">VOR DEM UMBRUCH</span>
                        }
                    </article>
                }
                if (sl)
                {
                    <div class="ar-slbar">
                        @if (doc.Versiegelt)
                        {
                            <span class="ar-tag">versiegelt · Spieler sehen nur das Siegel</span>
                        }
                        @if (doc.Verborgen)
                        {
                            <span class="ar-tag">versteckt</span>
                        }
                        <form class="ar-inline" asp-action="Siegel" method="post"><input type="hidden" name="id" value="@doc.Id" /><input type="hidden" name="kiste" value="@kisteCode" /><button type="submit" class="icon-btn">@(doc.Versiegelt ? "Siegel brechen" : "versiegeln")</button></form>
                        <form class="ar-inline" asp-action="Verstecken" method="post"><input type="hidden" name="id" value="@doc.Id" /><input type="hidden" name="kiste" value="@kisteCode" /><button type="submit" class="icon-btn">@(doc.Verborgen ? "den Spielern zeigen" : "verstecken")</button></form>
                        <a class="btn-primary" asp-action="Index" asp-route-kiste="@kisteCode" asp-route-dok="@doc.Id" asp-route-bearbeiten="true">✎ bearbeiten</a>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Volle Fensterbreite (JS: arFit)
            function arFit() {
                var el = document.querySelector('.ar-full'); if (!el) return;
                var docW = document.documentElement.clientWidth;
                el.style.marginLeft = '0px'; el.style.width = '';
                var r = el.getBoundingClientRect(); if (!r.width) return;
                el.style.marginLeft = (-r.left) + 'px'; el.style.width = docW + 'px';
                el.style.minHeight = Math.max(680, window.innerHeight - (r.top + window.scrollY)) + 'px';
            }
            window.addEventListener('resize', arFit); arFit(); setTimeout(arFit, 700);

            // Kategorien im Formular an/aus (JS: data-arkat)
            document.querySelectorAll('.ar-kc input').forEach(function (c) {
                c.addEventListener('change', function () { c.parentElement.classList.toggle('on', c.checked); });
            });

            // Spielleitung: Name/Signatur einer Kiste beim Tippen speichern, beim Verlassen neu zeichnen
            var kf = document.getElementById('arKisteForm');
            document.querySelectorAll('[data-kiste]').forEach(function (el) {
                var uhr = null;
                function senden(neuLaden) {
                    clearTimeout(uhr);
                    var fd = new FormData(kf); fd.append('id', el.dataset.kiste); fd.append('feld', el.dataset.feld); fd.append('wert', el.value);
                    fetch(kf.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'fetch' } })
                        .then(function () { if (neuLaden) { var u = new URL(location.href); u.searchParams.set('kisten', 'true'); location.href = u; } });
                }
                el.addEventListener('input', function () { clearTimeout(uhr); uhr = setTimeout(function () { senden(false); }, 600); });
                el.addEventListener('change', function () { senden(true); });
            });

            // Erst nachfragen (JS: mdArm)
            document.querySelectorAll('[data-zweistufig]').forEach(function (knopf) {
                var alt = knopf.innerHTML;
                knopf.addEventListener('click', function (e) {
                    if (knopf.classList.contains('armed')) return;
                    e.preventDefault();
                    knopf.classList.add('armed');
                    knopf.textContent = knopf.dataset.frage;
                    setTimeout(function () { if (knopf.isConnected) { knopf.classList.remove('armed'); knopf.innerHTML = alt; } }, 2800);
                });
            });
        })();
    </script>
}
