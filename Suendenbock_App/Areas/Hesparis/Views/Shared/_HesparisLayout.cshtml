@{
    // Bereich für die Navigation (siehe HesparisMenue): "Index", "Talente", "Zeugnis", "Tasche", "Stufen", "Sonder", "Charakter" …
    var bereich = ViewData["Bereich"] as string ?? "";
    var figurId = ViewData["FigurId"] as int?;
    // Zusätzliche Klasse für <body>, z. B. "on-home" auf der Übersicht (Nebel kräftiger, kein Abstand unten)
    var bodyKlasse = "hes";
    if (ViewData["BodyKlasse"] is string extra)
    {
        bodyKlasse += " " + extra;
    }
    var istGott = User.IsInRole("Gott");
    // Der eigene Hesparis-Charakter (setzt HesparisBaseController)
    var meinCharakter = ViewBag.MeinHesparisCharakter as HesparisCharakter;
    // Spieltag der Akademie (setzt HesparisBaseController), wie "Do, 3. September" in der HTML
    var spieltag = ViewBag.Spieltag as DateOnly?;

    // Haus-Knopf: aktiv auf der Übersicht
    string StartKlasse()
    {
        if (bereich == "Index")
        {
            return "topbar-link topbar-start active";
        }
        return "topbar-link topbar-start";
    }

    // Gruppen-Knopf: aktiv, wenn die offene Seite in dieser Gruppe liegt
    string GruppenKlasse(HesparisMenue.Gruppe gruppe)
    {
        if (gruppe.Eintraege.Any(e => e.Bereich == bereich))
        {
            return "topbar-link nav-group-btn active";
        }
        return "topbar-link nav-group-btn";
    }

}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#120a24" />
    <title>@ViewData["Title"] · Hesparis</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=UnifrakturMaguntia&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/hesparis.css" asp-append-version="true" />
</head>
<body class="@bodyKlasse">
    @* Bewegter Hintergrund wie in der HTML: drei Nebel, die langsam treiben *@
    <div id="bgFx" aria-hidden="true">
        <div class="nebula n1"></div><div class="nebula n2"></div><div class="nebula n3"></div>
        <div class="shoot"></div><div class="shoot two"></div>
    </div>

    <nav class="topbar">
        @* "Hesparis" führt zurück zum Startbild *@
        <a class="topbar-home" asp-controller="Home" asp-action="Index">Hesparis</a>
        @if (spieltag.HasValue)
        {
            <span class="topbar-day" title="Heute in der Spielwelt"><span class="td-date">@HesparisMenue.Spieltag(spieltag.Value)</span></span>
        }

        <div class="nav-main" role="menubar">
            <a class="@StartKlasse()" asp-controller="Home" asp-action="Uebersicht" asp-route-figur="@figurId" title="Übersicht" aria-label="Übersicht">
                <span class="glyph" aria-hidden="true">⌂</span>
            </a>

            @foreach (var gruppe in HesparisMenue.Gruppen)
            {
                <div class="nav-group">
                    <button type="button" class="@GruppenKlasse(gruppe)" aria-haspopup="true" aria-expanded="false" title="@gruppe.Text">
                        <span class="glyph" aria-hidden="true">@gruppe.Glyph</span><span class="link-txt">@gruppe.Text</span><span class="caret" aria-hidden="true">▾</span>
                    </button>
                    <div class="nav-drop" role="menu">
                        @foreach (var e in gruppe.Eintraege)
                        {
                            if (e.NurGott && !istGott)
                            {
                                continue;
                            }
                            var klasse = "nav-item";
                            if (e.NurGott)
                            {
                                klasse += " sl-only";
                            }
                            if (bereich == e.Bereich)
                            {
                                klasse += " active";
                            }

                            if (e.Controller == null)
                            {
                                @* Noch nicht gebaut *@
                                <span class="@klasse soon" role="menuitem" aria-disabled="true"><span class="glyph">@e.Glyph</span>@e.Text<small>bald</small></span>
                            }
                            else if (e.MitFigur)
                            {
                                <a class="@klasse" role="menuitem" asp-controller="@e.Controller" asp-action="@e.Action" asp-route-id="@figurId"><span class="glyph">@e.Glyph</span>@e.Text</a>
                            }
                            else
                            {
                                <a class="@klasse" role="menuitem" asp-controller="@e.Controller" asp-action="@e.Action"><span class="glyph">@e.Glyph</span>@e.Text</a>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <div class="topbar-right">
            @if (meinCharakter != null)
            {
                <span class="topbar-me" title="Dein Charakter in Hesparis">✦ @meinCharakter.Anzeigename</span>
            }
            <a class="topbar-back" asp-area="" asp-controller="Home" asp-action="Index" title="Zurück zu Sündenbock">←<span class="back-txt"> Sündenbock</span></a>
        </div>
    </nav>

    <main class="hes-main">
        @if (TempData["Success"] is string ok)
        {
            <div class="hes-flash ok">@ok</div>
        }
        @if (TempData["Error"] is string fehler)
        {
            <div class="hes-flash err">@fehler</div>
        }
        @RenderBody()
    </main>

    <script>
        // Ausklappmenüs wie in der HTML: Klick öffnet die Gruppe, Klick daneben oder Esc schließt.
        (function () {
            var gruppen = document.querySelectorAll('.nav-group');
            function alleZu(ausser) {
                gruppen.forEach(function (g) {
                    if (g === ausser) return;
                    g.classList.remove('open');
                    g.querySelector('.nav-group-btn').setAttribute('aria-expanded', 'false');
                });
            }
            gruppen.forEach(function (g) {
                var knopf = g.querySelector('.nav-group-btn');
                knopf.addEventListener('click', function (e) {
                    e.stopPropagation();
                    alleZu(g);
                    var offen = g.classList.toggle('open');
                    knopf.setAttribute('aria-expanded', offen ? 'true' : 'false');
                });
            });
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.nav-group')) alleZu(null);
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') alleZu(null);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
