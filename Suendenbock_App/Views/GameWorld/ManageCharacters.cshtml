@model IEnumerable<Suendenbock_App.Models.Domain.CharacterGameWorld>
@{
    ViewData["Title"] = "Characters verwalten";
    var gameWorld = ViewBag.GameWorld as Suendenbock_App.Models.Domain.GameWorld;
    var availableCharacters = ViewBag.AvailableCharacters as List<Suendenbock_App.Models.Domain.Character>;
    var originalwelt = ViewBag.Originalwelt as Suendenbock_App.Models.Domain.GameWorld;
    var inOriginalwelt = ViewBag.InOriginalwelt as HashSet<int> ?? new HashSet<int>();
    var spielerListe = ViewBag.Spieler as List<Suendenbock_App.Models.Domain.ApplicationUser> ?? new List<Suendenbock_App.Models.Domain.ApplicationUser>();

    // Spalte "Originalwelt" nur in den anderen Welten zeigen
    var istOriginalwelt = true;
    if (originalwelt != null && originalwelt.Id != gameWorld.Id)
    {
        istOriginalwelt = false;
    }
}

@section Styles {
    <link href="~/css/responsive-tables.css" rel="stylesheet" />
}

<div class="admin-container">
    <div class="container-fluid py-4">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <strong>Fehler:</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <strong>Erfolg:</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="pergament-header">Characters in @gameWorld.Name</h1>
                        <p class="text-muted">@gameWorld.Description</p>
                    </div>
                    <a asp-action="Index" class="btn btn-secondary">Zurück zur Übersicht</a>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Character hinzufügen -->
            <div class="col-md-4">
                <div class="pergament-table-card">
                    <h3 class="pergament-header mb-3">Characters hinzufügen</h3>

                    @if (availableCharacters != null && availableCharacters.Any())
                    {
                        <form asp-action="AddCharacters" method="post" id="mehrereHinzufuegen">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="gameWorldId" value="@gameWorld.Id" />

                            <input type="search" class="form-control mb-2" id="hinzufuegenFilter" placeholder="Name suchen …" aria-label="Characters filtern" />

                            <div class="border rounded p-2 mb-3" style="max-height: 360px; overflow-y: auto;">
                                @foreach (var character in availableCharacters)
                                {
                                    var suchtext = (character.Vorname + " " + character.Nachname + " " + character.Rufname).ToLower();
                                    <label class="form-check d-flex align-items-center gap-2 mb-1 hinzufuegen-zeile" data-suche="@suchtext">
                                        <input type="checkbox" class="form-check-input hinzufuegen-auswahl" name="characterIds" value="@character.Id" />
                                        <span>
                                            @character.Vorname @character.Nachname
                                            @if (!string.IsNullOrEmpty(character.Rufname))
                                            {
                                                <span class="text-muted">(@character.Rufname)</span>
                                            }
                                        </span>
                                        @if (!istOriginalwelt && originalwelt != null)
                                        {
                                            if (inOriginalwelt.Contains(character.Id))
                                            {
                                                <span class="badge bg-success ms-auto">auch in @originalwelt.Name</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary ms-auto">neu</span>
                                            }
                                        }
                                    </label>
                                }
                            </div>

                            <button type="submit" class="btn btn-primary w-100" id="hinzufuegenButton" disabled>
                                Hinzufügen (<span id="hinzufuegenAnzahl">0</span>)
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            Alle Characters sind bereits dieser Spielwelt zugeordnet.
                        </div>
                    }
                </div>
            </div>

            <!-- Zugeordnete Characters -->
            <div class="col-md-8">
                <div class="pergament-table-card">
                    <h3 class="pergament-header mb-3">Zugeordnete Characters (@Model.Count())</h3>

                    @if (Model.Any())
                    {
                        <!-- Sammel-Formular: die Checkboxen in der Tabelle gehören über form="mehrereEntfernen" dazu -->
                        <form id="mehrereEntfernen" asp-action="RemoveCharacters" method="post" class="d-flex align-items-center gap-3 mb-3"
                              onsubmit="return auswahlBestaetigen();">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="gameWorldId" value="@gameWorld.Id" />
                            <button type="submit" class="btn btn-danger" id="auswahlButton" disabled>
                                Auswahl entfernen (<span id="auswahlAnzahl">0</span>)
                            </button>
                        </form>

                        <div class="table-responsive">
                            <table class="medieval-table w-100">
                                <thead>
                                    <tr>
                                        <th><input type="checkbox" class="form-check-input" id="alleAuswaehlen" aria-label="Alle auswählen" /></th>
                                        <th>Rufname</th>
                                        <th>Vorname</th>
                                        <th>Nachname</th>
                                        @if (!istOriginalwelt)
                                        {
                                            <th>Originalwelt</th>
                                            <th>Spieler in dieser Welt</th>
                                        }
                                        <th>Hinzugefügt am</th>
                                        <th>Aktionen</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cgw in Model)
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox" class="form-check-input auswahl" form="mehrereEntfernen"
                                                       name="ids" value="@cgw.Id" aria-label="@cgw.Character.Vorname @cgw.Character.Nachname auswählen" />
                                            </td>
                                            <td>@cgw.Character.Rufname</td>
                                            <td>@cgw.Character.Vorname</td>
                                            <td>@cgw.Character.Nachname</td>
                                            @if (!istOriginalwelt)
                                            {
                                                <td>
                                                    @if (inOriginalwelt.Contains(cgw.CharacterId))
                                                    {
                                                        <span class="badge bg-success">auch in @originalwelt!.Name</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">nur hier</span>
                                                    }
                                                </td>
                                                <td>
                                                    @* Spieler nur für Nebencharaktere; leer = NPC (Lehrkraft, Mitschüler …) *@
                                                    <form asp-action="SetSpieler" method="post" class="d-flex gap-1">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@cgw.Id" />
                                                        <select name="userId" class="form-select form-select-sm" onchange="this.form.submit()"
                                                                aria-label="Spieler für @cgw.Character.Vorname @cgw.Character.Nachname">
                                                            <option value="">– NPC –</option>
                                                            @foreach (var spieler in spielerListe)
                                                            {
                                                                if (spieler.Id == cgw.UserId)
                                                                {
                                                                    <option value="@spieler.Id" selected>@spieler.UserName</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@spieler.Id">@spieler.UserName</option>
                                                                }
                                                            }
                                                        </select>
                                                    </form>
                                                </td>
                                            }
                                            <td>@cgw.AddedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <form asp-action="RemoveCharacter" asp-route-id="@cgw.Id" method="post"
                                                      onsubmit="return confirm('Character @cgw.Character.Vorname @cgw.Character.Nachname wirklich aus dieser Spielwelt entfernen?');"
                                                      style="display: inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        Entfernen
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <strong>Keine Characters zugeordnet.</strong> Füge Characters über das Formular links hinzu.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Mehrfachauswahl: "alle auswählen" und Anzahl im Button
        (function () {
            const alle = document.getElementById('alleAuswaehlen');
            const button = document.getElementById('auswahlButton');
            const anzahl = document.getElementById('auswahlAnzahl');
            if (!alle || !button) return;
            const boxen = Array.from(document.querySelectorAll('.auswahl'));

            function aktualisieren() {
                const n = boxen.filter(b => b.checked).length;
                anzahl.textContent = n;
                button.disabled = n === 0;
                alle.checked = n === boxen.length;
                alle.indeterminate = n > 0 && n < boxen.length;
            }
            alle.addEventListener('change', function () {
                boxen.forEach(b => b.checked = alle.checked);
                aktualisieren();
            });
            boxen.forEach(b => b.addEventListener('change', aktualisieren));
        })();

        // Hinzufügen: Filter nach Namen und Anzahl im Button
        (function () {
            const filter = document.getElementById('hinzufuegenFilter');
            const button = document.getElementById('hinzufuegenButton');
            const anzahl = document.getElementById('hinzufuegenAnzahl');
            if (!button) return;
            const boxen = Array.from(document.querySelectorAll('.hinzufuegen-auswahl'));
            boxen.forEach(b => b.addEventListener('change', function () {
                const n = boxen.filter(x => x.checked).length;
                anzahl.textContent = n;
                button.disabled = n === 0;
            }));
            if (filter) {
                filter.addEventListener('input', function () {
                    const q = filter.value.trim().toLowerCase();
                    document.querySelectorAll('.hinzufuegen-zeile').forEach(function (z) {
                        z.style.display = z.dataset.suche.includes(q) ? '' : 'none';
                    });
                });
            }
        })();

        function auswahlBestaetigen() {
            const n = document.querySelectorAll('.auswahl:checked').length;
            return confirm(n + ' Character(s) aus dieser Spielwelt entfernen? Die Characters selbst bleiben erhalten.');
        }
    </script>
}
