@{
    ViewData["Title"] = "Akademie";
    ViewData["Bereich"] = "Index";
}
<div class="armory-head">
    <div class="armory-eyebrow">Akademie Hesparis</div>
    <h1 class="armory-title">Die Tore sind noch verschlossen</h1>
    <p class="armory-sub">
        Keiner deiner Characters ist einer Spielwelt mit Hesparis-Kampagne zugeordnet.
        Die Spielleitung legt die Kampagne unter „Spielleitung“ an und ordnet sie der Spielwelt zu.
    </p>
</div>
@if (User.IsInRole("Gott"))
{
    <p style="text-align:center">
        <a class="hes-btn" asp-controller="HesparisSpielleitung" asp-action="Index">Zur Spielleitung</a>
    </p>
}
