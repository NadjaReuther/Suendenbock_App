@model Suendenbock_App.Models.ViewModels.ThreadDetailViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = Model.Title;
}

<div class="thread-detail-container">

    <a asp-action="Forum" class="td-back-link">
        <span class="material-symbols-outlined">arrow_back</span>
        Zurück zum Forum
    </a>
    <div class="td-main-post">
        <div class="td-post-accent"></div>

        <div class="td-post-inner">
            <div class="td-post-meta">
                <div class="td-meta-left">
                    <span class="td-category-badge">
                        <span class="material-symbols-outlined">@Model.CategoryIcon</span>
                        @Model.CategoryName
                    </span>
                    <span class="td-meta-time">
                        <span class="material-symbols-outlined">schedule</span>
                        @Model.CreatedAt
                    </span>
                    <span class="td-meta-author">
                        <span class="material-symbols-outlined">person</span>
                        @Model.AuthorName
                    </span>
                    @if (Model.IsPinned)
                    {
                        <span class="td-pin-badge">
                            <span class="material-symbols-outlined">push_pin</span>
                            Angepinnt
                        </span>
                    }
                </div>

                <div class="td-action-buttons">
                    @if (Model.CanEdit)
                    {
                        <a asp-action="EditThread" asp-route-id="@Model.Id" class="td-btn-edit">
                            <span class="material-symbols-outlined">edit</span>
                            Bearbeiten
                        </a>
                    }
                    @if (Model.CanDelete)
                    {
                        <form asp-action="DeleteThread" asp-route-id="@Model.Id" method="post" class="td-delete-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="td-btn-delete"
                                    data-delete-form="true" data-delete-message="Thread wirklich archivieren?">
                                <span class="material-symbols-outlined">delete</span>
                                Löschen
                            </button>
                        </form>
                    }
                </div>
            </div>

            <h1 class="td-title">@Model.Title</h1>
            <div class="td-content-box">
                <div class="td-content wiki-content">
                    @Html.Raw(Model.Content)
                </div>
            </div>
        </div>
    </div>

    <div class="td-replies-section">
        <div class="td-replies-header">
            <h3 class="td-replies-title">Antworten (@Model.Replies.Count)</h3>
            <span class="material-symbols-outlined td-replies-icon">chat_bubble_outline</span>
        </div>

        @if (!Model.Replies.Any())
        {
            <div class="td-empty-replies">
                <span class="material-symbols-outlined">history_edu</span>
                <p>Stille herrscht in diesem Saal. Erhebt Eure Stimme!</p>
            </div>
        }
        else
        {
            @foreach (var reply in Model.Replies)
            {
                <div class="td-reply-card" id="reply-@reply.Id">
                    <div class="td-reply-header">
                        <div class="td-reply-author">
                            <div class="td-avatar">
                                <span class="material-symbols-outlined">person</span>
                            </div>
                            <span class="td-reply-name">@reply.AuthorName</span>
                        </div>
                        <div class="td-reply-actions">
                            <span class="td-reply-time">@reply.CreatedAt</span>
                            @if (reply.CanEdit)
                            {
                                <button type="button" class="td-btn-icon-edit"
                                        onclick="toggleReplyEdit(@reply.Id)"
                                        title="Antwort bearbeiten">
                                    <span class="material-symbols-outlined">edit</span>
                                </button>
                            }
                            @if (reply.CanDelete)
                            {
                                <form asp-action="DeleteReply"
                                      asp-route-id="@reply.Id"
                                      asp-route-threadId="@Model.Id"
                                      method="post" class="td-inline-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="td-btn-icon-delete"
                                            data-delete-form="true" data-delete-message="Antwort löschen?">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="td-reply-content" id="reply-text-@reply.Id">@Html.Raw(reply.Content)</div>

                    <form asp-action="EditReply" method="post"
                          id="reply-edit-form-@reply.Id" style="display:none;" class="td-edit-reply-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@reply.Id" />
                        <input type="hidden" name="threadId" value="@Model.Id" />
                        <textarea name="content" rows="3" class="td-reply-textarea" id="reply-editor-@reply.Id">@reply.Content</textarea>
                        <div class="td-edit-reply-actions">
                            <button type="button" class="td-btn-icon-cancel"
                                    onclick="toggleReplyEdit(@reply.Id)">
                                Abbrechen
                            </button>
                            <button type="submit" class="td-btn-send td-btn-send-small">
                                <span class="material-symbols-outlined">save</span>
                                Speichern
                            </button>
                        </div>
                    </form>
                </div>
            }
        }
    </div>

    <div class="td-reply-form-card">
        <h4 class="td-reply-form-title">
            <span class="material-symbols-outlined">edit_note</span>
            Eure Replik verfassen
        </h4>
        <form asp-action="PostReply" method="post" id="newReplyForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="threadId" value="@Model.Id" />
            <textarea name="content" rows="4"
                      class="td-reply-textarea" id="newReplyEditor"
                      placeholder="Was habt Ihr zu dieser Kunde zu sagen?"></textarea>
            <div class="td-reply-form-footer">
                <button type="submit" class="td-btn-send">
                    <span class="material-symbols-outlined">send</span>
                    Absenden
                </button>
            </div>
        </form>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/thread-detail.css" />
}
@section Scripts {
    <script>
        // CKEditor-Instanzen für Bearbeitungsformulare speichern
        const replyEditors = {};
        let newReplyEditor = null;

        // CKEditor für neues Kommentarfeld initialisieren
        document.addEventListener('DOMContentLoaded', function() {
            ClassicEditor.create(document.querySelector('#newReplyEditor'))
                .then(editor => {
                    newReplyEditor = editor;
                })
                .catch(console.error);

            // Form-Validierung für neuen Kommentar
            const newReplyForm = document.getElementById('newReplyForm');
            newReplyForm.addEventListener('submit', function(e) {
                if (newReplyEditor) {
                    const content = newReplyEditor.getData().trim();
                    if (!content || content === '') {
                        e.preventDefault();
                        alert('Bitte gib einen Kommentar ein.');
                        return false;
                    }
                }
            });
        });

        // Wechselt zwischen Anzeigetext und Bearbeitungsformular
        async function toggleReplyEdit(replyId) {
            const text = document.getElementById('reply-text-' + replyId);
            const form = document.getElementById('reply-edit-form-' + replyId);
            const isEditing = form.style.display !== 'none';

            if (isEditing) {
                // Bearbeitungsmodus verlassen - Editor zerstören
                if (replyEditors[replyId]) {
                    await replyEditors[replyId].destroy();
                    delete replyEditors[replyId];
                }
                text.style.display = 'block';
                form.style.display = 'none';
            } else {
                // Bearbeitungsmodus aktivieren - Editor initialisieren
                text.style.display = 'none';
                form.style.display = 'block';

                if (!replyEditors[replyId]) {
                    const editorElement = document.querySelector('#reply-editor-' + replyId);
                    replyEditors[replyId] = await ClassicEditor.create(editorElement)
                        .catch(console.error);
                }
            }
        }
    </script>
}