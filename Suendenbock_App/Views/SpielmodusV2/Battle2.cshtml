@model Suendenbock_App.Controllers.BattleV2ViewModel
@{
    ViewData["Title"] = "Kampf V2 - Neues System";
}

@section Styles {
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet" />

    <!-- Material Symbols -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/battle-v2.css" />
}

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 text-white overflow-x-hidden relative font-['Inter']" id="battleV2Container">
    <!-- Animated Background -->
    <div class="fixed inset-0 opacity-30 pointer-events-none">
        <div class="absolute inset-0 bg-[url('/images/battle/grid.svg')] bg-repeat opacity-10"></div>
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-purple-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-pulse"></div>
        <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-pulse animation-delay-2000"></div>
    </div>

    <!-- Main Container -->
    <main class="relative z-10 container mx-auto px-4 py-8 max-w-7xl">

        <!-- Header Section -->
        <header class="mb-8">
            <div class="bg-gradient-to-r from-slate-800/80 to-slate-900/80 backdrop-blur-xl border border-purple-500/30 rounded-2xl p-6 shadow-2xl">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center space-x-4">
                        <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-blue-600 rounded-xl flex items-center justify-center">
                            <span class="material-symbols-outlined text-4xl text-white">swords</span>
                        </div>
                        <div>
                            <h1 class="text-4xl font-['Orbitron'] font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400">
                                KAMPF V2
                            </h1>
                            <p class="text-purple-300 text-sm font-medium">Neues Kampfsystem</p>
                        </div>
                    </div>

                    @if (!Model.IsGod)
                    {
                        <div class="bg-red-500/20 border border-red-500/50 rounded-xl px-6 py-3 backdrop-blur-sm">
                            <div class="flex items-center space-x-2">
                                <span class="material-symbols-outlined text-red-300">visibility</span>
                                <span class="text-red-300 font-semibold">Nur-Lese-Modus</span>
                            </div>
                        </div>
                    }
                </div>

                <!-- Round Counter -->
                <div class="text-center py-4 bg-slate-950/50 rounded-xl border border-purple-500/20">
                    <div class="text-purple-400 text-sm font-semibold uppercase tracking-wider mb-1">Runde</div>
                    <div class="text-6xl font-['Orbitron'] font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400" id="currentRoundV2">1</div>
                    <div class="text-purple-300 text-lg mt-2 font-medium" id="turnIndicatorV2">Warte auf Initialisierung...</div>
                </div>
            </div>
        </header>

        <!-- Environment Effects Section -->
        <section class="mb-6 space-y-4">
            <!-- Biom Banner -->
            <div id="biomBannerV2" class="hidden bg-gradient-to-r from-green-900/40 to-emerald-900/40 backdrop-blur-xl border border-green-500/30 rounded-xl p-4 shadow-lg">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <span class="material-symbols-outlined text-3xl text-green-400">landscape</span>
                        <div>
                            <h3 class="text-white font-bold text-lg" id="activeBiomNameV2">Aktuelles Biom</h3>
                            <button onclick="openBiomDescriptionPanelV2()" class="text-green-300 hover:text-green-200 text-xs underline transition-colors">
                                Details anzeigen
                            </button>
                        </div>
                    </div>
                    @if (Model.IsGod)
                    {
                        <div class="flex gap-2">
                            <button onclick="openEffectModalV2('biom')" class="bg-green-500/20 hover:bg-green-500/30 text-green-300 border border-green-500/50 px-4 py-2 rounded-lg text-sm font-semibold transition-all hover:scale-105">
                                Ändern
                            </button>
                            <button onclick="removeBiomV2()" class="bg-red-500/20 hover:bg-red-500/30 text-red-300 border border-red-500/50 px-4 py-2 rounded-lg text-sm font-semibold transition-all hover:scale-105">
                                ✕
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Field Effects -->
            <div id="fieldEffectsBannerV2" class="hidden bg-gradient-to-r from-amber-900/40 to-orange-900/40 backdrop-blur-xl border border-amber-500/30 rounded-xl p-4 shadow-lg">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center space-x-2">
                        <span class="material-symbols-outlined text-2xl text-amber-400">bolt</span>
                        <h3 class="text-white font-bold text-lg">Feldeffekte</h3>
                    </div>
                    @if (Model.IsGod)
                    {
                        <button onclick="openEffectModalV2('field')" class="bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/50 px-4 py-2 rounded-lg text-sm font-semibold transition-all hover:scale-105">
                            + Effekt hinzufügen
                        </button>
                    }
                </div>
                <div id="activeFieldEffectsContainerV2" class="flex flex-wrap gap-2">
                    <!-- Active field effects will be rendered here -->
                </div>
            </div>
        </section>

        <!-- Battle Actions Bar (God Only) -->
        @if (Model.IsGod)
        {
            <div class="mb-6 bg-gradient-to-r from-slate-800/80 to-slate-900/80 backdrop-blur-xl border border-purple-500/30 rounded-xl p-4 shadow-lg">
                <div class="flex items-center justify-between">
                    <button onclick="openAddParticipantModalV2()" class="flex items-center space-x-2 bg-blue-500/20 hover:bg-blue-500/30 text-blue-300 border border-blue-500/50 px-5 py-3 rounded-lg font-semibold transition-all hover:scale-105">
                        <span class="material-symbols-outlined">person_add</span>
                        <span>Teilnehmer hinzufügen</span>
                    </button>

                    <div class="flex items-center space-x-3">
                        <button onclick="nextTurnV2()" class="flex items-center space-x-2 bg-gradient-to-r from-purple-500 to-blue-500 hover:from-purple-600 hover:to-blue-600 text-white px-8 py-3 rounded-lg font-bold text-lg transition-all hover:scale-105 shadow-lg hover:shadow-purple-500/50">
                            <span class="material-symbols-outlined">skip_next</span>
                            <span>Nächster Zug</span>
                        </button>

                        <button onclick="endBattleV2()" class="flex items-center space-x-2 bg-red-500/20 hover:bg-red-500/30 text-red-300 border border-red-500/50 px-5 py-3 rounded-lg font-semibold transition-all hover:scale-105">
                            <span class="material-symbols-outlined">close</span>
                            <span>Kampf beenden</span>
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Participants Section -->
        <section class="mb-6">
            <!-- View Toggle -->
            <div class="mb-4 flex items-center space-x-2 bg-slate-800/50 rounded-lg p-1 w-fit border border-purple-500/20">
                <button onclick="toggleViewModeV2('grid')" id="btnViewGrid" class="px-4 py-2 rounded-md font-semibold text-sm transition-all bg-purple-500 text-white">
                    <span class="material-symbols-outlined text-lg">grid_view</span>
                </button>
                <button onclick="toggleViewModeV2('list')" id="btnViewList" class="px-4 py-2 rounded-md font-semibold text-sm transition-all text-gray-400 hover:text-white">
                    <span class="material-symbols-outlined text-lg">view_list</span>
                </button>
            </div>

            <!-- Participants Container -->
            <div id="participantsContainerV2" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Participants will be rendered here via JavaScript -->
            </div>
        </section>

        <!-- Defeated Panel Toggle -->
        <button onclick="toggleDefeatedPanelV2()" class="fixed bottom-8 left-8 bg-red-900/80 hover:bg-red-900 border-2 border-red-500/50 text-red-300 px-6 py-4 rounded-2xl font-bold transition-all hover:scale-105 shadow-2xl backdrop-blur-xl flex items-center space-x-3 z-30">
            <span class="material-symbols-outlined text-2xl">skull</span>
            <span>Gefallene</span>
            <span id="defeatedCountBadgeV2" class="bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full hidden">0</span>
        </button>

    </main>

    <!-- Victory/Defeat Screen -->
    <div id="resultScreenV2" class="fixed inset-0 bg-black/95 backdrop-blur-xl hidden flex items-center justify-center z-50">
        <div class="text-center space-y-8 animate-in fade-in duration-700">
            <div class="text-9xl" id="resultIconV2"></div>
            <h1 class="text-7xl font-['Orbitron'] font-black uppercase tracking-wider" id="resultTitleV2"></h1>
            <p class="text-2xl text-gray-400" id="resultMessageV2"></p>
            <div class="flex justify-center gap-4 pt-8">
                <a href="/Spielmodus/Dashboard" class="bg-gradient-to-r from-purple-500 to-blue-500 hover:from-purple-600 hover:to-blue-600 text-white px-12 py-4 font-bold uppercase tracking-wider text-lg rounded-xl hover:scale-105 transition-all shadow-lg">
                    Zurück zum Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Modals & Panels (will be added in separate includes or kept compact) -->
@* TODO: Add modals for effects, add participant, etc. - similar structure to original but with V2 styling *@

@section Scripts {
    <!-- SignalR Client Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Model-Daten für JavaScript
        const BATTLE_V2_MODEL_DATA = {
            characters: @Html.Raw(Json.Serialize(Model.Characters)),
            monsters: @Html.Raw(Json.Serialize(Model.Monsters)),
            allFieldEffects: @Html.Raw(Json.Serialize(Model.AllFieldEffects)),
            allBiomes: @Html.Raw(Json.Serialize(Model.AllBiomes))
        };

        const IS_GOTT_V2 = @Json.Serialize(Model.IsGod);
        const SESSION_ID_V2 = @Json.Serialize(Model.SessionId);
    </script>

    <!-- Load JavaScript Modules -->
    <script src="~/js/battle2-globals.js"></script>
    <script type="module" src="~/js/battle2-main.js"></script>

    <style>
        /* Custom animations */
        @@keyframes fade-in {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-in {
            animation: fade-in 0.5s ease-out;
        }

        .animation-delay-2000 {
            animation-delay: 2s;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 5px;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #a855f7, #3b82f6);
            border-radius: 5px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, #9333ea, #2563eb);
        }
    </style>
}
