@model Suendenbock_App.Models.ViewModels.AppPostViewModel
@{
    ViewData["Title"] = "Post";
}

<h2 class="sec"><span class="ms">mail</span>Post</h2>

<div class="chiprow" role="navigation" aria-label="Ordner">
    <a class="fchip @(Model.IsSentFolder ? "" : "on")" href="/App/Post"><span class="ms">inbox</span>Eingang@(Model.UnreadCount > 0 ? $" · {Model.UnreadCount}" : "")</a>
    <a class="fchip @(Model.IsSentFolder ? "on" : "")" href="/App/Post?ordner=gesendet"><span class="ms">send</span>Gesendet</a>
</div>

@if (Model.HasCharacter)
{
    <a href="/App/NeueNachricht" class="btn-gold" style="margin-bottom:12px"><span class="ms">edit</span>Neue Nachricht</a>
}

<div class="card">
    @if (!Model.HasCharacter)
    {
        <p class="empty"><span class="ms">person_off</span>Für Nachrichten braucht dein Konto einen Charakter.</p>
    }
    else if (!Model.Messages.Any())
    {
        <p class="empty"><span class="ms">drafts</span>@(Model.IsSentFolder ? "Du hast noch nichts gesendet." : "Dein Posteingang ist leer.")</p>
    }
    else
    {
        @foreach (var m in Model.Messages)
        {
            var unread = !m.IsRead || m.UnreadCount > 0;
            <a class="item" href="/App/Nachricht/@m.Id">
                <div class="ic" style="border-radius:50%;font-weight:600" aria-hidden="true">@(string.IsNullOrEmpty(m.OtherCharacterName) ? "?" : m.OtherCharacterName.Substring(0, 1).ToUpper())</div>
                <div class="body">
                    <h4>
                        @if (unread)
                        {
                            <span class="udot" aria-label="ungelesen"></span>
                        }
                        @(Model.IsSentFolder ? "An " : "")@m.OtherCharacterName
                        <span class="muted" style="margin-left:auto;font-weight:400;font-size:11.5px" data-ago="@(new DateTimeOffset(m.SentAt).ToUnixTimeMilliseconds())"></span>
                    </h4>
                    <p style="color:var(--ink);@(unread ? "font-weight:600" : "")">
                        @m.Subject
                        @if (m.MessageCount > 1)
                        {
                            <span class="muted" style="font-weight:400">(@m.MessageCount)</span>
                        }
                    </p>
                    <p>@m.ContentPreview</p>
                </div>
            </a>
        }
    }
</div>
