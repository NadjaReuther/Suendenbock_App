@model Suendenbock_App.Models.ViewModels.AppComposeViewModel
@{
    ViewData["Title"] = "Neue Nachricht";
}

<a class="back" href="/App/Post"><span class="ms">chevron_left</span>Post</a>

<h2 class="sec"><span class="ms">edit</span>Neue Nachricht</h2>

<form class="card" id="composeForm">
    @if (!string.IsNullOrEmpty(Model.SenderName))
    {
        <p class="muted" style="font-size:13px;margin:0 0 10px">Du schreibst als <b>@Model.SenderName</b>.</p>
    }
    <div class="fld">
        <label for="cTo">An</label>
        <select id="cTo" name="to" required>
            <option value="">Bitte wählen …</option>
            @foreach (var g in Model.Receivers.GroupBy(r => r.Group))
            {
                <optgroup label="@g.Key">
                    @foreach (var r in g)
                    {
                        <option value="@r.Value">@r.Name</option>
                    }
                </optgroup>
            }
        </select>
    </div>
    <div class="fld">
        <label for="cSubject">Betreff</label>
        <input id="cSubject" name="subject" maxlength="200" required />
    </div>
    <div class="fld">
        <label for="cText">Nachricht</label>
        <textarea id="cText" name="content" required style="min-height:200px"></textarea>
    </div>
    <button type="submit" class="btn-gold"><span class="ms">send</span>Senden</button>
</form>
