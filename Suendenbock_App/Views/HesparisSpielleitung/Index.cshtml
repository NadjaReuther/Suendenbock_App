@model SpielleitungIndexViewModel
@{
    ViewData["Title"] = "Spielleitung";
    ViewData["Bereich"] = "Spielleitung";
}

<div class="armory-head">
    <div class="armory-eyebrow">Spielleitung</div>
    <h1 class="armory-title">Kampagnen</h1>
    <p class="armory-sub">
        Jede Kampagne gehört zu einer Spielwelt aus dem Sündenbock-Tenant-System.
        Die Spielfiguren sind eure bestehenden Characters.
    </p>
</div>

<section class="a-panel sl-panel">
    <h3>Alle Kampagnen</h3>
    @if (Model.Kampagnen.Count == 0)
    {
        <p class="empty-state">Noch keine Kampagne angelegt.</p>
    }
    else
    {
        <table class="sl-table">
            <thead>
                <tr><th>Name</th><th>Spielwelt</th><th>Spieltag</th><th>Schuljahr</th><th>Figuren</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var z in Model.Kampagnen)
                {
                    <tr>
                        <td>@z.Kampagne.Name</td>
                        <td><span class="sl-tag">@z.Welt</span></td>
                        <td>@z.Kampagne.Spieltag.ToString("dd.MM.yyyy")</td>
                        <td>@z.Kampagne.Schuljahr.</td>
                        <td>@z.Figuren</td>
                        <td style="white-space:nowrap">
                            <a class="icon-btn" style="display:inline-flex;align-items:center;text-decoration:none" asp-action="Figuren" asp-route-id="@z.Kampagne.Id">Figuren</a>
                            <a class="icon-btn" style="display:inline-flex;align-items:center;text-decoration:none" asp-controller="Hesparis" asp-action="Index" asp-route-kampagneId="@z.Kampagne.Id">ansehen</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="a-panel sl-panel">
    <h3>Neue Kampagne</h3>
    @if (Model.Welten.Count == 0)
    {
        <p class="empty-state">Es gibt noch keine Spielwelt. Lege zuerst eine unter „Spielwelten“ an.</p>
    }
    else
    {
        <form asp-action="Anlegen" method="post" class="hes-form-row">
            <label class="hes-field" style="flex:2 1 220px"><span>Name</span>
                <input class="hes-input" name="Name" required maxlength="200" placeholder="z. B. Akademie Hesparis · Gruppe 1c" />
            </label>
            <label class="hes-field"><span>Spielwelt</span>
                <select class="hes-select" name="GameWorldId">
                    @foreach (var w in Model.Welten)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </label>
            <label class="hes-field"><span>Spieltag</span>
                <input class="hes-input" type="date" name="Spieltag" value="@Model.Neu.Spieltag.ToString("yyyy-MM-dd")" />
            </label>
            <label class="hes-field" style="flex:0 1 110px"><span>Schuljahr</span>
                <input class="hes-input" type="number" min="1" name="Schuljahr" value="@Model.Neu.Schuljahr" />
            </label>
            <button type="submit" class="hes-btn">Anlegen</button>
        </form>
    }
</section>
