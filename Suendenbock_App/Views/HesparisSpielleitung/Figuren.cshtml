@model SpielleitungFigurenViewModel
@{
    ViewData["Title"] = "Spielfiguren";
    ViewData["Bereich"] = "Spielleitung";
    var k = Model.Kampagne;
}

<div class="armory-head">
    <div class="armory-eyebrow">Spielleitung · @k.GameWorld.Name</div>
    <h1 class="armory-title">@k.Name</h1>
    <p class="armory-sub">
        Alle Spieler, deren Character der Spielwelt „@k.GameWorld.Name“ zugeordnet ist, sind automatisch dabei.
        Hier kannst du zusätzlich Characters einschreiben oder die Reihenfolge ändern.
    </p>
</div>

<section class="a-panel sl-panel">
    <h3>Akademie</h3>
    <form asp-action="Bearbeiten" method="post" class="hes-form-row">
        <input type="hidden" name="Id" value="@k.Id" />
        <label class="hes-field" style="flex:2 1 220px"><span>Name</span>
            <input class="hes-input" name="Name" value="@k.Name" required maxlength="200" />
        </label>
        <label class="hes-field"><span>Spielwelt</span>
            <select class="hes-select" name="GameWorldId">
                @foreach (var w in Model.Welten)
                {
                    if (w.Id == k.GameWorldId)
                    {
                        <option value="@w.Id" selected>@w.Name</option>
                    }
                    else
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                }
            </select>
        </label>
        <label class="hes-field"><span>Spieltag</span>
            <input class="hes-input" type="date" name="Spieltag" value="@k.Spieltag.ToString("yyyy-MM-dd")" />
        </label>
        <label class="hes-field" style="flex:0 1 110px"><span>Schuljahr</span>
            <input class="hes-input" type="number" min="1" name="Schuljahr" value="@k.Schuljahr" />
        </label>
        <button type="submit" class="hes-btn ghost">Speichern</button>
    </form>
</section>

<section class="a-panel sl-panel">
    <h3>Spielfiguren</h3>
    @if (Model.Figuren.Count == 0)
    {
        <p class="empty-state">Noch niemand eingeschrieben.</p>
    }
    else
    {
        <table class="sl-table">
            <thead>
                <tr><th>#</th><th>Character</th><th>Spieler</th><th>LP</th><th>Geld</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var z in Model.Figuren)
                {
                    <tr>
                        <td>@(z.Figur.Position + 1)</td>
                        <td>@z.Name</td>
                        <td>
                            @if (z.Spieler != null)
                            {
                                <span class="sl-tag ok">@z.Spieler</span>
                            }
                            else
                            {
                                <span class="sl-tag">ohne Spieler</span>
                            }
                        </td>
                        <td>@z.Figur.LebenspunkteAktuell / @z.Figur.LebenspunkteMax</td>
                        <td>@HesparisRegeln.GeldText(z.Figur.Geld)</td>
                        <td style="white-space:nowrap">
                            <form asp-action="FigurVerschieben" method="post" class="inline">
                                <input type="hidden" name="id" value="@k.Id" />
                                <input type="hidden" name="figurId" value="@z.Figur.Id" />
                                <input type="hidden" name="nachOben" value="true" />
                                <button type="submit" class="icon-btn" aria-label="nach oben">↑</button>
                            </form>
                            <form asp-action="FigurVerschieben" method="post" class="inline">
                                <input type="hidden" name="id" value="@k.Id" />
                                <input type="hidden" name="figurId" value="@z.Figur.Id" />
                                <input type="hidden" name="nachOben" value="false" />
                                <button type="submit" class="icon-btn" aria-label="nach unten">↓</button>
                            </form>
                            <a class="icon-btn" style="display:inline-flex;align-items:center;text-decoration:none" asp-controller="Hesparis" asp-action="Talente" asp-route-id="@z.Figur.Id">öffnen</a>
                            <form asp-action="FigurEntfernen" method="post" class="inline"
                                  onsubmit="return confirm('Figur mit Noten, Talenten und Tasche entfernen? Der Character selbst bleibt erhalten.')">
                                <input type="hidden" name="id" value="@k.Id" />
                                <input type="hidden" name="figurId" value="@z.Figur.Id" />
                                <button type="submit" class="icon-btn danger" aria-label="entfernen">✕</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="a-panel sl-panel">
    <h3>Character einschreiben</h3>
    <p class="armory-sub" style="margin:0 0 12px;text-align:left">
        Ist der Character noch nicht in der Spielwelt „@k.GameWorld.Name“, wird er dort automatisch ergänzt.
    </p>
    @if (Model.Verfuegbar.Count == 0)
    {
        <p class="empty-state">Alle Characters spielen schon mit.</p>
    }
    else
    {
        <form asp-action="FigurHinzufuegen" method="post" class="hes-form-row">
            <input type="hidden" name="id" value="@k.Id" />
            <label class="hes-field" style="flex:2 1 260px"><span>Character</span>
                <select class="hes-select" name="characterId">
                    @foreach (var c in Model.Verfuegbar)
                    {
                        var zusatz = "";
                        if (c.HatSpieler)
                        {
                            zusatz += " · Spieler";
                        }
                        if (c.InWelt)
                        {
                            zusatz += " · in der Welt";
                        }
                        <option value="@c.Id">@(c.Name + zusatz)</option>
                    }
                </select>
            </label>
            <button type="submit" class="hes-btn">Einschreiben</button>
        </form>
    }
</section>
