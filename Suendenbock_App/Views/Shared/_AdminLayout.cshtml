<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin - Suendenbock_App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Suendenbock_App.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.7/css/dataTables.dataTables.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="/css/components.css" rel="stylesheet" />
    <link href="/css/animations.css" rel="stylesheet" />
    <link href="/css/antique-theme.css" rel="stylesheet" />
    <link href="~/css/wysiwyg-editor.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=MedievalSharp&family=Uncial+Antiqua&family=Cinzel:wght@400;600&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Material Symbols Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-white" asp-area="" asp-controller="Home" asp-action="Index">Sündenbock 1618</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-users"></i> Charaktere
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Character" asp-action="Form">Neuer Charakter</a></li>
                                <li><a class="dropdown-item" asp-controller="Character" asp-action="Overview">Alle Charaktere</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-magic"></i> Monster
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Monster" asp-action="Form">Neues Monster</a></li>
                                <li><a class="dropdown-item" asp-controller="Monster" asp-action="Overview">Alle Monster</a></li>
                                <li><hr /></li>
                                <li><a class="dropdown-item" asp-controller="Monstertyp" asp-action="Form">Neuer Monstertyp</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-flag"></i> Verbände
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Guild" asp-action="Form">Neue Gilde</a></li>
                                <li><a class="dropdown-item" asp-controller="Guild" asp-action="Overview">Alle Gilden</a></li>
                                <li><hr /></li>
                                <li><a class="dropdown-item" asp-controller="Infanterie" asp-action="Form">Neue Infanterie</a></li>
                                <li><a class="dropdown-item" asp-controller="Infanterie" asp-action="Overview">Alle Infanterien</a></li>
                                <li><hr /></li>
                                <li><a class="dropdown-item" asp-controller="Regiment" asp-action="Form">Neues Regiment</a></li>
                                <li><a class="dropdown-item" asp-controller="Infanterie" asp-action="Overview">Alle Regimente</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Glossary" asp-action="Index">
                                Glossar
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <!-- Messages Dropdown -->
                        <li>
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                Verlassen
                            </a>
                        </li>
                        <li class="nav-item dropdown mailbutton">
                            <a class="nav-link notification-bell-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" id="messagesDropdown" title="Nachrichten">
                                <span class="material-symbols-outlined text-white">mail</span>
                                <span class="notification-badge" id="messagesBadge" style="display: none;">0</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Messages" asp-action="Inbox">
                                        <span class="material-symbols-outlined">inbox</span> Posteingang
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Messages" asp-action="Sent">
                                        <span class="material-symbols-outlined">send</span> Gesendet
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Messages" asp-action="Compose">
                                        <span class="material-symbols-outlined">edit</span> Ankündigung senden
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Messages" asp-action="Admin">
                                        <span class="material-symbols-outlined">admin_panel_settings</span> Mails-Übersicht
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <!-- User Dropdown -->
                        <li class="nav-item dropdown user-avatar-item">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown">
                                <span class="user-avatar">@User?.Identity?.Name?.Substring(0, 1)</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">⚙️ Datenbank</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="ManageFeldEffekte">⚡ Umweltbank</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="GenerateSession">🎮 Aktverwaltung</a></li>
                                <li><a class="dropdown-item" asp-controller="UserManagement" asp-action="Index">👥 Benutzerverwaltung</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="ManageAchievements">🏆 Achievementverwaltung</a></li>
                                @* <li><a class="dropdown-item" asp-controller="Admin" asp-action="ManageBiome">🌍 Biome</a></li> *@
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="ManageMaps">🗺️ Kartenverwaltung</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="QRGenerator">📱 QR-Generator</a></li>
                                <li><a class="dropdown-item" asp-controller="AdventCalendar" asp-action="AdminDashboard">🎄 Eventverwaltung</a></li>
                                <li><hr /></li>
                                <li>
                                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
                                        <i class="fas fa-key"></i> Passwort ändern
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <div style="display:flex; flex-direction:row; align-items:center;">
                                        <div>
                                            <form asp-area="Identity" asp-page="/Account/Logout"
                                                  asp-route-returnUrl="@Url.Action("Index", "Home")"
                                                  method="post">
                                                <button type="submit" class="dropdown-item" style="font-size:20px;">
                                                    <i class="fas fa-sign-out-alt"></i> Logout
                                                </button>
                                            </form>
                                        </div>
                                        <div>
                                            <!-- Notification Bell Icon -->
                                            <a class="nav-link notification-bell-link" asp-controller="Community" asp-action="NotificationSettings" id="notificationBellIcon" title="Benachrichtigungen">
                                                <span class="material-symbols-outlined" id="bellIcon">notifications_off</span>
                                                <span class="notification-badge" id="notificationBadge" style="display: none;">!</span>
                                            </a>
                                        </div>
                                    </div>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-dark">
        <div class="container">
            <span class="text-white">&copy; 2025 - Suendenbock_App - Admin Panel - Author: acidlady</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/messages-notification.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/2.1.7/js/dataTables.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>



    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>